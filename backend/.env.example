# =============================================================================
# Elite Fitness Backend - Production & Development Environment Configuration
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL with SSL for production cloud e.g. Neon, Supabase, Render, Heroku)
DATABASE_URL=postgresql://username:password@host:5432/elite_fitness_db?sslmode=require
DATABASE_SSL=true

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_generate_using_openssl_rand_hex_64
JWT_EXPIRES_IN=7d

# OTP Security Settings
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Email SMTP (Google Gmail App Password or SendGrid / Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAIL_FROM=Elite Fitness <youremail@gmail.com>

# Razorpay Payment Gateway (Live or Test keys)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret

# Cloudinary Media Storage (For gym photos and receipts)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Cloud Messaging (Push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"

# Production URLs & CORS Allowed Origins
# The GitHub Pages domain where qr-registration-web is deployed
FRONTEND_URL=https://vikasyadav00.github.io/Elite-Fitness
QR_WEB_URL=https://vikasyadav00.github.io/Elite-Fitness
OWNER_APP_URL=https://vikasyadav00.github.io/Elite-Fitness/owner
CORS_ORIGIN=https://vikasyadav00.github.io,http://localhost:3000,http://localhost:3001

# Public QR URLs encoded into reception posters
PUBLIC_REGISTRATION_URL=https://vikasyadav00.github.io/Elite-Fitness/register
PUBLIC_FEEDBACK_URL=https://vikasyadav00.github.io/Elite-Fitness/feedback
PUBLIC_ATTENDANCE_URL=https://vikasyadav00.github.io/Elite-Fitness/checkin
